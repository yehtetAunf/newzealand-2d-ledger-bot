{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newzealand-2d-ledger-bot",
  "main": "src/index.js",
  "compatibility_date": "2026-07-30",

  "observability": {
    "enabled": true
  },

"d1_databases": [
  {
    "binding": "DB",
    "database_name": "ledger-db",
    "database_id": "862438dc-abcc-44b3-b5ce-24bbd8c8fa4b"
  }
],

"vars": {
  "BOT_NAME": "New Zealand 2D Ledger Bot",
  "TIMEZONE": "Asia/Yangon"
},

  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
